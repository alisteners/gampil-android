<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".presentation.operator.cari.CariFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarCari"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Cari Pengaduan"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewOperator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:queryHint="Cari berdasarkan kategori, deskripsi..."
            app:iconifiedByDefault="false"
            android:background="@drawable/bg_outline_abu"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Filter Berdasarkan Status :"
            tools:ignore="HardcodedText" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="?attr/colorSurfaceContainer">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chipFilterSemua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua"
                android:checked="true"
                tools:ignore="HardcodedText" />
            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chipFilterMenunggu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menunggu"
                tools:ignore="HardcodedText" />
            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chipFilterDiproses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diproses"
                tools:ignore="HardcodedText" />
            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chipFilterSelesai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selesai"
                tools:ignore="HardcodedText" />
        </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCari"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_pengaduan_publik"/>

        <TextView
            android:id="@+id/textViewPesanCari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gunakan kata kunci untuk memulai pencarian."
            android:layout_gravity="center"
            android:visibility="visible"
            tools:ignore="HardcodedText" />

        <ProgressBar
            android:id="@+id/progressBarCari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"/>
    </FrameLayout>

</LinearLayout>
